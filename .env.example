# Copy this file to .env and change the values for your machine.
# .env itself is never committed (it is in .gitignore).

# Port the app listens on
PORT=3000

# Where the SQLite database file lives (created automatically)
DB_FILE=data/task-manager.db

# How many days a sign-in lasts
SESSION_DAYS=7

# development or production (production marks the session cookie secure, for HTTPS)
NODE_ENV=development
